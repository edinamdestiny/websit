# Cloudflare Pages Headers Configuration
# Documentation: https://developers.cloudflare.com/pages/configuration/headers/

# HTML & General Files (Freshness validation)
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Cache-Control: public, max-age=0, must-revalidate

# Immutable Hashed Static Assets (Instant Edge CDN Delivery)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Logos & Profile Images (1 month cache)
/logo*.jpg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
